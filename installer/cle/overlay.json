  "plugins": {
    "allow": [
      "active-memory",
      "admin-http-rpc",
      "browser",
      "canvas",
      "file-transfer",
      "logbook",
      "memory-core",
      "memory-wiki",
      "ollama",
      "pinkie-mode-architecture",
      "pinkie-project-scope",
      "talk-voice",
      "openai",
      "workboard",
      "llm-task",
      "document-extract",
      "web-readability",
      "duckduckgo",
      "cle-studio"
    ],
    "entries": {
      "active-memory": {
        "enabled": true
      },
      "admin-http-rpc": {
        "enabled": true
      },
      "logbook": {
        "enabled": true,
        "config": {
          "captureEnabled": false
        }
      },
      "memory-wiki": {
        "enabled": true
      },
      "pinkie-project-scope": {
        "enabled": true,
        "hooks": {
          "allowPromptInjection": true,
          "allowConversationAccess": true
        }
      },
      "pinkie-mode-architecture": {
        "enabled": true,
        "hooks": {
          "allowPromptInjection": true,
          "allowConversationAccess": true
        }
      },
      "browser": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "canvas": {
        "enabled": true,
        "config": {
          "host": {
            "enabled": true
          }
        }
      },
      "workboard": {
        "enabled": true
      },
      "llm-task": {
        "enabled": true,
        "llm": {
          "allowModelOverride": true,
          "allowAuthProfileOverride": true
        },
        "config": {}
      },
      "document-extract": {
        "enabled": true
      },
      "web-readability": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      },
      "cle-studio": {
        "enabled": true
      }
    },
    "load": {
      "paths": [
        "{{EXT}}/pinkie-project-scope",
        "{{EXT}}/pinkie-mode-architecture",
        "{{EXT}}/cle-studio"
      ]
    }
  },
  "gateway": {
    "mode": "local",
    "port": "{{PORT}}",
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    },
    "terminal": {
      "enabled": true
    },
    "controlUi": {
      "experimental": {
        "customPlugins": true
      }
    }
  },
  "update": {
    "channel": "stable",
    "checkOnStart": false,
    "auto": {
      "enabled": false
    }
  },
  "nodeHost": {
    "autoUpdate": {
      "enabled": false
    }
  },
  "ui": {
    "prefs": {
      "themeMode": "system"
    }
  },
  "channels": {},
  "bindings": []
}