<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.super-pinkie.tts</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@SERVER@</string>
    <string>18888</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/super-pinkie-tts.log</string>
  <key>StandardErrorPath</key><string>/tmp/super-pinkie-tts.log</string>
</dict>
</plist>
