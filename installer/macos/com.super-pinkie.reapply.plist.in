<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.super-pinkie.reapply</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>@APPLY_SCRIPT@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PINKIE_APP_PATH</key><string>@APP_PATH@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>/tmp/super-pinkie-reapply.log</string>
  <key>StandardErrorPath</key><string>/tmp/super-pinkie-reapply.log</string>
</dict>
</plist>
