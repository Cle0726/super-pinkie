<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 2026-10-04: live plist once carried FIRST_BYTE_TIMEOUT=8 + RETRY_BUDGET=20.
       Any request with a large context needs 15-25s for its first byte, so every
       attempt was cut at 8s and 64 retries all died — big sessions got a fake
       "upstream unavailable" 503 while small requests looked fine. Pin generous
       values here so a reinstall can never bring that wall back.
       2026-11-26: 60 / 180 was still too short. hy4flash-free long-context replies
       take 76-90s for their first byte, so each attempt was cut at 60s and the
       budget ran out on retries. 180 / 300 covers that; a Feishu reply is capped
       at 300s, so a longer budget buys nothing. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>UR_PROXY_FIRST_BYTE_TIMEOUT</key>
    <string>180</string>
    <key>UR_PROXY_RETRY_BUDGET</key>
    <string>300</string>
  </dict>
  <key>Label</key>
  <string>com.openclaw.mm-retry-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/Admin/bin/mm-retry-proxy.py</string>
    <string>1467</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/openclaw-mm-retry-proxy.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/openclaw-mm-retry-proxy.log</string>
</dict>
</plist>
