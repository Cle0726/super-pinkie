      'set -euo pipefail\n' +
      '\n' +
      'SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"\n' +
      'REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"\n' +
      'USER_HOME="${HOME:?HOME is not set}"\n' +
      'ASSET_ROOT="$REPO_ROOT/ui/assets"\n' +
      'INJECTION_ROOT="$REPO_ROOT/ui/injections"\n' +
      'LAUNCHER_SOURCE="$REPO_ROOT/desktop/macos/Sources/Launcher.swift"\n' +
      'LAUNCHER_SUPPORT_SOURCES=("$REPO_ROOT/desktop/macos/Sources/MaterialPreview.swift" "$REPO_ROOT/desktop/macos/Sources/BrowserControl.swift")\n' +
      'NODE_VERSIONS_ROOT="$USER_HOME/.nvm/versions/node"\n' +
      'LAUNCHER_APP_PATH="${PINKIE_APP_PATH:-/Applications/超級碧琪.app}"\n' +
      'SKIP_APP_BUNDLES="${PINKIE_SKIP_APP_BUNDLES:-0}"\n' +
      'BUNDLE_BUILD_ONLY="${PINKIE_BUNDLE_BUILD_ONLY:-0}"\n' +
      'PYTHON_BIN="${PINKIE_PYTHON_BIN:-/usr/bin/python3}"\n' +
      '\n' +
      'copy_if_changed() {\n' +
      '  local source_file="$1"\n' +
      '  local target_file="$2"\n' +
      '  if [[ ! -f "$target_file" ]] || ! cmp -s "$source_file" "$target_file"; then\n' +
      '    cp "$source_file" "$target_file"\n' +
      '    DID_CHANGE=1\n' +
      '  fi\n' +
      '}\n' +
      '\n' +
      '# 更新器可能遇到“/asset”与“./asset”两种等价路径。先统一路径并按资源名\n' +
      '# 去重，避免重复运行主题安装后把同一份脚本执行两次。\n' +
      'dedupe_laolao_asset_tags() {\n' +
      '  local index_file="$1"\n' +
      '  local temp_index\n' +
      '  temp_index="$(mktemp "$(dirname "$index_file")/.laolao-dedupe.XXXXXX")"\n' +
      "  perl -0pe '\n" +
      '    BEGIN { %seen = (); }\n' +
      '    s{(<script\\b[^>]*\\bsrc="(?:\\./|/)?(laolao-[^"?]+)[^"]*"[^>]*>\\s*</script>|<link\\b[^>]*\\bhref="(?:\\./|/)?(laolao-[^"?]+)[^"]*"[^>]*>)}{\n' +
      '      my $asset = defined($2) ? $2 : $3;\n' +
      '      $seen{$asset}++ ? "" : $1;\n' +
      '    }gise;\n' +
      '    s{((?:src|href)=")/(laolao-)}{$1 . "./" . $2}ge;\n' +
      `  ' "$index_file" > "$temp_index"\n` +
      '  if cmp -s "$index_file" "$temp_index"; then\n' +
      '    rm -f "$temp_index"\n' +
      '  else\n' +
      '    mv "$temp_index" "$index_file"\n' +
      '    DID_CHANGE=1\n' +
      '  fi\n' +
      '}\n' +
      '\n' +
      'apply_ui_skin() {\n' +
      '  local ui_root="$1"\n' +
      '  local index_file="$ui_root/index.html"\n' +
      '  local asset\n' +
      '\n' +
      '  [[ -f "$index_file" ]] || return 0\n' +
      '\n' +
      '  dedupe_laolao_asset_tags "$index_file"\n' +
      '\n' +
      '  # Work on one canonical relative form while patching. The final form is\n' +
      '  # root-relative, so nested SPA routes such as /settings/general never look\n' +
      '  # for the skin under /settings/ and briefly fall back to stock dark UI.\n' +
      `  perl -0pi -e 's{"/laolao-}{"./laolao-}g' "$index_file"\n` +
