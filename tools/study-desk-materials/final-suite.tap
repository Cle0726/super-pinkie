        laolao-pinkie-buddy-unrestricted-happy.png \
        laolao-pinkie-buddy-unrestricted-sleepy.png \
        laolao-pinkie-status-thinking.png \
        laolao-pinkie-status-working.png \
        laolao-pinkie-status-writing.png \
