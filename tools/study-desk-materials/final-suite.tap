      '        #else\n' +
      '        return ProcessInfo.processInfo.environment["PINKIE_TEST_HOST"] == "1"\n' +
      '        #endif\n' +
      '    }()\n' +
      '\n' +
      '    /// The C.le. app (its own bundle, released apart from 超級碧琪) declares `CLEBrand = cle` in\n' +
