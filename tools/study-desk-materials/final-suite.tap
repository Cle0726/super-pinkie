            let fallback = isTestHost ? "http://127.0.0.1:19789/" : (isCleBrand ? "http://127.0.0.1:18809/" : "http://127.0.0.1:18789/")
            // C.le. never adopts a gateway address that names 超級碧琪's port. Both apps can
