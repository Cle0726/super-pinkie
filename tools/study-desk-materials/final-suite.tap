      '  echo "error: 构建机没有可用的 OpenClaw" >&2\n' +
      '  exit 1\n' +
      'fi\n' +
      'OPENCLAW_ENTRY="$(realpath "$OPENCLAW_BIN")"\n' +
      'OPENCLAW_ROOT="$(dirname "$OPENCLAW_ENTRY")"\n' +
      'if [[ ! -f "$OPENCLAW_ROOT/package.json" || ! -f "$OPENCLAW_ROOT/openclaw.mjs" ]]; then\n' +
