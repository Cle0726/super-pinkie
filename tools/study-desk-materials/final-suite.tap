      '# and the bundled JavaScript SDK are both for this exact release.\n' +
      'CUA_DRIVER_VERSION="0.22.0"\n' +
      'CUA_DRIVER_ARCHIVE="cua-driver-rs-$CUA_DRIVER_VERSION-darwin-universal.tar.gz"\n' +
      'CUA_DRIVER_URL="https://github.com/trycua/cua/releases/download/cua-driver-rs-v$CUA_DRIVER_VERSION/$CUA_DRIVER_ARCHIVE"\n' +
