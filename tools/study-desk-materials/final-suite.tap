    "/* Manual context compaction for every chat mode. Uses OpenClaw's native\n" +
      '   sessions.compact RPC directly, so no slash-command message appears in chat. */\n' +
      '(() => {\n' +
      '  "use strict";\n' +
      '\n' +
      '  const BUTTON_CLASS = "laolao-context-compact-btn";\n' +
      '  const POPOVER_ID = "laolao-context-compact-popover";\n' +
      '  const COMPACTION_STATE_PREFIX = "laolao.context-compaction.v1:";\n' +
      '  const COMPACTION_COMPLETE_MS = 10_000;\n' +
      '  const COMPACTION_MAX_AGE_MS = 15 * 60_000;\n' +
      '  let busy = false;\n' +
      '  let popover = null;\n' +
      '  let usage = null;\n' +
      '  let usageKey = "";\n' +
      '  let usageFetchedAt = 0;\n' +
      '  let usageRequest = null;\n' +
      '  let sessionInfo = null;\n' +
      '  let glyphLoad;\n' +
      '  const glyphBase = document.currentScript?.src;\n' +
      '  function mountCompactionGlyph(icon, phase) {\n' +
      '    if (window.__pinkieCompactionGlyph) { window.__pinkieCompactionGlyph.mount(icon,phase); return; }\n' +
      "    glyphLoad ||= new Promise((resolve,reject)=>{const script=document.createElement('script');script.src=new URL('./laolao-compaction-glyph.js?v=compactionglyph2',glyphBase||location.href).href;script.onload=resolve;script.onerror=reject;document.head.append(script);});\n" +
      "    glyphLoad.then(()=>{if(icon.isConnected)window.__pinkieCompactionGlyph?.mount(icon,icon.closest('.laolao-compaction-notice')?.dataset.phase||phase);}).catch(()=>{});\n" +
      '  }\n' +
      '  const noticeMotionObserver = typeof IntersectionObserver === "function" ? new IntersectionObserver((entries) => {\n' +
      '    for (const entry of entries) {\n' +
      '      entry.target.dataset.onscreen = entry.isIntersecting ? "1" : "0";\n' +
      '      entry.target.dataset.motion = !document.hidden && entry.isIntersecting ? "running" : "paused";\n' +
      '      window.__pinkieCompactionGlyph?.setVisible(entry.target.querySelector(".laolao-compaction-notice__icon"),entry.target.dataset.motion==="running");\n' +
      '    }\n' +
      '  }, {threshold: 0}) : null;\n' +
      '  document.addEventListener("visibilitychange", () => {\n' +
      '    document.querySelectorAll(".laolao-compaction-notice").forEach((node) => {\n' +
      '      node.dataset.motion = !document.hidden && node.dataset.onscreen !== "0" ? "running" : "paused";\n' +
      '      window.__pinkieCompactionGlyph?.setVisible(node.querySelector(".laolao-compaction-notice__icon"),node.dataset.motion==="running");\n' +
      '    });\n' +
      '  });\n' +
      '\n' +
      '  const currentSessionKey = () => {\n' +
      '    const routed = new URLSearchParams(location.search).get("session") || "";\n' +
      '    if (/^agent:(main|project|thinking|learning|unrestricted):/.test(routed)) return routed;\n' +
      '    const active = document.querySelector(".sidebar-recent-session--active[data-session-key]");\n' +
      '    return active?.dataset?.sessionKey || "";\n' +
      '  };\n' +
      '\n' +
      '  const toast = (message) => {\n' +
      '    const shared = window.__laolaoToast;\n' +
      '    if (typeof shared === "function") shared(message);\n' +
      '    else window.dispatchEvent(new CustomEvent("laolao:toast", {detail: {message}}));\n' +
      '  };\n' +
      '\n' +
      '  const closePopover = () => {\n' +
      '    popover?.remove();\n' +
      '    popover = null;\n' +
      '    document.querySelector(`.${BUTTON_CLASS}`)?.setAttribute("aria-expanded", "false");\n' +
      '  };\n' +
      '\n' +
      '  const formatTokens = (value) => {\n' +
      '    if (value == null || value === "") return "";\n' +
      '    const number = Number(value);\n' +
      '    return Number.isFinite(number) ? Math.round(number).toLocaleString() : "";\n' +
      '  };\n' +
      '\n' +
      '  const contextCapacity = (session, defaults) => {\n' +
      '    if (session?.totalTokens == null) return null;\n' +
      '    const used = Number(session?.totalTokens);\n' +
      '    const limit = Number(session?.contextTokens || defaults?.contextTokens);\n' +
      '    if (!Number.isFinite(used) || used < 0 || !Number.isFinite(limit) || limit <= 0) return null;\n' +
      '    const percent = Math.min(100, Math.round(used / limit * 100));\n' +
      '    const sourceBudget = session?.pinkieCompactionBudget;\n' +
      '    const compactionBudget = sourceBudget\n' +
      '      && Number(sourceBudget.window) === limit\n' +
      '      && Number.isFinite(Number(sourceBudget.threshold))\n' +
      '      && Number.isFinite(Number(sourceBudget.triggerRatio))\n' +
      '      ? {window: Number(sourceBudget.window), threshold: Number(sourceBudget.threshold), triggerRatio: Number(sourceBudget.triggerRatio)}\n' +
      '      : null;\n' +
      '    return {used, limit, percent, approximate: session?.totalTokensFresh === false, compactionBudget};\n' +
      '  };\n' +
      '\n' +
      '  const compactionStorageKey = (key) => `${COMPACTION_STATE_PREFIX}${encodeURIComponent(key)}`;\n' +
      '\n' +
      '  const readCompactionState = (key) => {\n' +
      '    if (!key) return null;\n' +
      '    try {\n' +
      '      const state = JSON.parse(localStorage.getItem(compactionStorageKey(key)) || "null");\n' +
      '      if (!state || !Number.isFinite(Number(state.startedAt))) return null;\n' +
      '      const age = Date.now() - Number(state.startedAt);\n' +
      '      if (state.phase === "complete" || state.phase === "skipped" || state.phase === "failed") {\n' +
      '        if (!Number.isFinite(Number(state.completedAt)) || Date.now() - Number(state.completedAt) > COMPACTION_COMPLETE_MS) {\n' +
      '          localStorage.removeItem(compactionStorageKey(key));\n' +
      '          return null;\n' +
      '        }\n' +
      '      } else if (age > COMPACTION_MAX_AGE_MS) {\n' +
      '        localStorage.removeItem(compactionStorageKey(key));\n' +
      '        return null;\n' +
      '      }\n' +
      '      return state;\n' +
      '    } catch { return null; }\n' +
      '  };\n' +
      '\n' +
      '  const saveCompactionState = (key, state) => {\n' +
      '    try { localStorage.setItem(compactionStorageKey(key), JSON.stringify(state)); } catch {}\n' +
      '  };\n' +
      '\n' +
      '  const readSessionInfo = async (key, timeout = 15_000) => {\n' +
      '    const rpc = window.__laolaoSidebar?.gwRequest;\n' +
      '    if (!key || typeof rpc !== "function") return null;\n' +
      '    const agentId = key.split(":")[1];\n' +
      '    const result = await rpc("sessions.list", {agentId, limit: 1000}, timeout);\n' +
      '    const session = result?.sessions?.find?.((item) => item.key === key) || null;\n' +
      '    return {key, session, capacity: contextCapacity(session, result?.defaults), result};\n' +
      '  };\n' +
      '\n' +
      '  const captureCompactionBaseline = (key, startedAt) => {\n' +
      '    void readSessionInfo(key).then((info) => {\n' +
      '      const state = readCompactionState(key);\n' +
      '      if (!state || state.startedAt !== startedAt || !["active", "retrying"].includes(state.phase)) return;\n' +
      '      if (state.beforeTokens == null && Number.isFinite(info?.capacity?.used)) state.beforeTokens = info.capacity.used;\n' +
      '      if (state.beforeCount == null && Number.isFinite(Number(info?.session?.compactionCount))) state.beforeCount = Number(info.session.compactionCount);\n' +
      '      saveCompactionState(key, state);\n' +
      '      if (usageKey === key && info?.capacity) {\n' +
      '        sessionInfo = info;\n' +
      '        usage = info.capacity;\n' +
      '        renderContextViewer();\n' +
      '      }\n' +
      '    }).catch(() => {});\n' +
      '  };\n' +
      '\n' +
      '  const beginCompaction = (key, source, runId = "") => {\n' +
      '    if (!key) return;\n' +
      '    const previous = readCompactionState(key);\n' +
      '    const continuing = previous && ["active", "retrying"].includes(previous.phase);\n' +
      '    const startedAt = continuing ? previous.startedAt : Date.now();\n' +
      '    const sessionCount = sessionInfo?.key === key ? Number(sessionInfo.session?.compactionCount) : NaN;\n' +
      '    const state = {\n' +
      '      ...(continuing ? previous : {}),\n' +
      '      phase: "active",\n' +
      '      source: previous?.source || source,\n' +
      '      runId: runId || previous?.runId || "",\n' +
      '      startedAt,\n' +
      '      beforeTokens: previous?.beforeTokens ?? (usageKey === key ? usage?.used : null),\n' +
      '      beforeCount: previous?.beforeCount ?? (Number.isFinite(sessionCount) ? sessionCount : null)\n' +
      '    };\n' +
      '    saveCompactionState(key, state);\n' +
      '    renderCompactionNotice();\n' +
      '    if (state.beforeTokens == null || state.beforeCount == null) captureCompactionBaseline(key, startedAt);\n' +
      '  };\n' +
      '\n' +
      '  const finishCompaction = (key, details = {}) => {\n' +
      '    const previous = readCompactionState(key);\n' +
      '    if (!previous || (["complete", "skipped", "failed"].includes(previous.phase) && details.final !== true)) return;\n' +
      '    const phase = details.completed ? "complete" : details.outcome === "skipped" ? "skipped" : "failed";\n' +
      '    const state = {\n' +
      '      ...previous,\n' +
      '      phase,\n' +
      '      completedAt: Date.now(),\n' +
      '      beforeTokens: details.tokensBefore != null && Number.isFinite(Number(details.tokensBefore)) ? Number(details.tokensBefore) : previous.beforeTokens,\n' +
      '      afterTokens: details.tokensAfter != null && Number.isFinite(Number(details.tokensAfter)) ? Number(details.tokensAfter) : null,\n' +
      '      message: details.message || ""\n' +
      '    };\n' +
      '    saveCompactionState(key, state);\n' +
      '    renderCompactionNotice();\n' +
      '    if (phase !== "complete" || state.afterTokens != null) return;\n' +
      '    const completedAt = state.completedAt;\n' +
